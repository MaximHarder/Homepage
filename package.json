{
  "name": "maxim-harder-homepage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "vue-tsc -b && vite build",
    "build:cloudflare": "vue-tsc -b && vite build --config vite.config.cloudflare.ts",
    "build:client": "vue-tsc -b && vite build --config vite.config.client.ts",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/cloudflare-turnstile": "^0.2.2",
    "cfturnstile-vue3": "^2.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.22",
    "vue-i18n": "^9.14.0",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.11.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.5"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
